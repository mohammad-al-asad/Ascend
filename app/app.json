{
  "expo": {
    "name": "Ascend Human Performance",
    "slug": "ascend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "ascend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app/icon.png",
      "bundleIdentifier": "com.dominionperformance.ascend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dominionperformance.ascend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161618",
          "image": "./assets/app/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b225a221-14d8-460c-b198-9735f81f2c43"
      }
    }
  }
}
